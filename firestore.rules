rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil bisa dibaca siapa saja (perlu untuk fitur Jelajahi & Cocok
    // Untukmu), tapi menulis harus dalam keadaan sudah login (anonim).
    match /profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Permintaan tukar: siapa saja yang login (anonim) boleh membuat,
    // tidak boleh diubah/dihapus pihak lain setelah dibuat.
    match /requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Dokumen penanda seeding data contoh.
    match /meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
